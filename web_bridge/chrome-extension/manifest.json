{
  "manifest_version": 3,
  "name": "知骨影像 · 网页取图",
  "version": "1.5.0",
  "description": "在云影像/内网 PACS 网页上显示一个按钮，一键把当前检查的 DICOM 送到本机「知骨影像」打开。",
  "permissions": ["storage", "nativeMessaging", "cookies"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*", "http://*/*", "https://*/*"],
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["boot.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "把当前影像送到知骨影像",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
